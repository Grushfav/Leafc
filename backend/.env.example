# Neon Postgres connection string
# Find this in Neon Console → Project → Connect → Node.js
DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"

# Server
PORT=4000

# Comma-separated site origins for CORS. First value is used in email links.
FRONTEND_ORIGIN="https://leafc.net,https://leafc.co,http://localhost:3000"

# JWT signing secret — generate a long random string for production
JWT_SECRET="replace-with-a-long-random-secret"

# Required to create admin / senior agent / agent accounts
STAFF_INVITE_CODE="replace-with-a-private-member-code"

# AWS SES SMTP (from address must be a verified SES identity)
AWS_SES_REGION="us-east-1"
SES_SMTP_USER=""
SES_SMTP_PASSWORD=""
SES_FROM_EMAIL="info@leafc.net"
SES_FROM_NAME="LEAF-C"
SES_NOTIFY_EMAIL="info@leafc.net"
