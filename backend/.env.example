# Neon Postgres connection string
# Find this in Neon Console → Project → Connect → Node.js
DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"

# Server
PORT=4000

# Comma-separated site origins for CORS.
# Email links use the first public origin and ignore localhost.
FRONTEND_ORIGIN="https://leafc.net,https://leafc.co,http://localhost:3000"

# JWT signing secret — generate a long random string for production
JWT_SECRET="replace-with-a-long-random-secret"

# Required to create admin / senior agent / agent accounts
STAFF_INVITE_CODE="replace-with-a-private-member-code"

# AWS SES SMTP (from address must be a verified SES identity)
AWS_SES_REGION="us-east-1"
SES_SMTP_USER=""
SES_SMTP_PASSWORD=""
SES_FROM_EMAIL="support@leafc.net"
SES_FROM_NAME="LEAF-C"
SES_NOTIFY_EMAIL="support@leafc.net"

# Object storage for CMS/avatar uploads (S3-compatible: AWS S3, Cloudflare R2, Neon Object Storage).
# Leave unset to keep files under backend/uploads/ (local/dev).
# Aliases also accepted: BUCKET_NAME / R2_BUCKET, AWS_* / R2_* credentials, R2_ENDPOINT, BUCKET_PUBLIC_URL / R2_PUBLIC_URL.
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Required for R2 / custom endpoints (e.g. https://<accountid>.r2.cloudflarestorage.com)
S3_ENDPOINT=""
# Public base URL returned to clients (R2 custom domain / r2.dev, CloudFront, or S3 website/CDN).
# Required when S3_ENDPOINT is set; optional for plain AWS S3 (defaults to virtual-hosted URL).
S3_PUBLIC_URL=""
